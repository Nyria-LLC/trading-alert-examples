// Nyria example: a strategy that sends a JSON alert per order with alert_message.
//
// Where the webhook URL goes
//   1. In Nyria, create a strategy with TradingView as the alert source. Open its
//      Integration tab and copy the webhook URL. It has the form
//      https://trades.nyria.io/webhooks/<your-strategy-token>
//   2. Add this script to a chart, then open the alert dialog (Alt+A, or Option+A on a Mac).
//   3. Condition: this strategy. Choose "Order fills only".
//   4. Message: replace the text with exactly   {{strategy.order.alert_message}}
//      TradingView swaps that placeholder for the alert_message of the order that filled.
//   5. Notifications: tick "Webhook URL" and paste the URL from step 1.
//   6. Create the alert.
//
// One alert covers both entries and exits because each order carries its own message.
// Messages this script sends for SPY:
//   {"action": "OPEN", "instrument": "SPY", "direction": "LONG"}
//   {"action": "CLOSE", "instrument": "SPY", "direction": "LONG"}
//
// To skip alert_message, leave it out of the calls below and paste strategy-order-fills.json from a
// broker folder (for example ../schwab/) into the Message box instead. That message reads the
// side of each fill from TradingView's {{strategy.*}} placeholders.
//
// The strategy's own quantity is not sent. Nyria sizes each order from the bot's budget per
// entry. Run the strategy on a paper bot before any live account sees it.
//@version=6
strategy("Nyria strategy alert_message example: SMA cross", overlay = true, default_qty_type = strategy.fixed, default_qty_value = 1)

fastLength = input.int(9, "Fast SMA length", minval = 1)
slowLength = input.int(21, "Slow SMA length", minval = 2)

fast = ta.sma(close, fastLength)
slow = ta.sma(close, slowLength)

plot(fast, "Fast SMA", color = color.teal)
plot(slow, "Slow SMA", color = color.orange)

nyriaMessage(string action, string direction) =>
    '{"action": "' + action + '", "instrument": "' + syminfo.ticker + '", "direction": "' + direction + '"}'

openLong = ta.crossover(fast, slow)
closeLong = ta.crossunder(fast, slow)

if openLong
    strategy.entry("Long", strategy.long, alert_message = nyriaMessage("OPEN", "LONG"))

if closeLong
    strategy.close("Long", alert_message = nyriaMessage("CLOSE", "LONG"))
